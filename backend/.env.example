# ============================================
# AI-NAS V7.0 环境变量配置
# ============================================
# 使用方法：
#   1. 复制此文件为 .env
#   2. 填写实际值（不要提交 .env 到 Git！）
#   3. 在 backend/ 目录下启动服务
#
# 注意：大部分配置在 config/*.yaml 中管理
#       环境变量仅用于敏感信息和运行时覆盖
# ============================================

# ── 服务器设置 ──
AI_NAS_HOST=0.0.0.0
AI_NAS_PORT=8000
AI_NAS_DEBUG=false

# ── JWT 认证 ──
# 重要：生产环境必须设置强密钥！
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
AI_NAS_JWT_SECRET=
AI_NAS_TOKEN_EXPIRE_HOURS=24

# ── CORS 跨域 ──
# 多个域名用逗号分隔，留空则使用 config/web.yaml 中的默认值
# 示例：AI_NAS_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
AI_NAS_CORS_ORIGINS=

# ── 数据库 ──
# 默认使用 config/global.yaml 中的 database.path
# 可通过环境变量覆盖
AI_NAS_DB_PATH=./data/metadata.db

# ── Redis（可选）──
# 留空则使用内存缓存（功能降级但不影响使用）
AI_NAS_REDIS_URL=

# ── 存储路径 ──
# 默认使用 config/storage.yaml 中的 paths
# 可通过环境变量覆盖
AI_NAS_UPLOAD_PATH=./data/uploads
AI_NAS_THUMBNAIL_PATH=./data/thumbnails
AI_NAS_ORIGINAL_PATH=./data/original

# ── 日志级别 ──
# 可选值：DEBUG / INFO / WARNING / ERROR
AI_NAS_LOG_LEVEL=INFO

# ── 限流（可选）──
# 开启后在 config/web.yaml 中设置阈值
AI_NAS_RATE_LIMIT=false

# ── 测试环境 ──
# 仅在运行 pytest 时设置
# AI_NAS_TESTING=true
