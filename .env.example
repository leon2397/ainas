# ==============================================================================
#  AI-NAS Media Manager - 环境变量配置
#  复制此文件为 .env 并根据需要修改
# 
#  Docker 部署：docker compose up -d
#  本地开发：cp .env.example .env 后修改
# ==============================================================================

# ─── 服务配置 ─────────────────────────────────────────────────────────────
# 服务端口（默认 8000）
BACKEND_PORT=8000

# 内存限制（根据设备配置调整）
BACKEND_MEM_LIMIT=1G

# CPU 限制
BACKEND_CPU_LIMIT=1.0

# ─── NAS 存储 ─────────────────────────────────────────────────────────────
# 媒体文件存储路径（宿主机目录，容器通过卷挂载）
# 示例：群晖为 /volume1/ai-nas，Windows 为 D:/nas
NAS_PATH=./nas

# ─── JWT 认证 ─────────────────────────────────────────────────────────────
# 生产环境必须设置！否则重启后用户需要重新登录
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：首次启动会自动生成并保存到 data/.env，重启不失效
AI_NAS_JWT_SECRET=

# Token 过期时间（小时），默认 24 小时
# AI_NAS_TOKEN_EXPIRE_HOURS=24

# ─── CORS 跨域 ─────────────────────────────────────────────────────────────
# 允许的跨域来源，多个用逗号或空格分隔
# 示例：AI_NAS_CORS_ORIGINS=http://192.168.1.100:8000,https://example.com
# 生产环境建议只放域名或 IP，不要用 *
# 留空则使用默认值（仅 localhost 开发环境）
# AI_NAS_CORS_ORIGINS=

# ─── 日志级别 ─────────────────────────────────────────────────────────────
# 可选：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# ─── 外部存储（可选）─────────────────────────────────────────────────────
# 外接存储路径（如有）
# STORAGE_EXTERNAL_PATH=/mnt/storage

# ─── 限流配置（可选）─────────────────────────────────────────────────────
# API 限流：每分钟允许的请求数，0 为禁用
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=100