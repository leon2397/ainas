# 敏感配置与密钥
.env
*.key
*.pem
!*.example

# K8s 真实密钥不入库（仅提交 example 版本）
k8s/secret.yaml
!k8s/secret.example.yaml

# 测试临时产物
.pytest_baseline.xml

# 运行时数据与日志（保留目录结构）
logs/
data/
backend/data/*
!backend/data/**/
!backend/data/**/.gitkeep
backend/logs/*
!backend/logs/**/
!backend/logs/**/.gitkeep
nas/
*.db
*.db-wal
*.db-shm
# 运行时自动生成的密钥文件（后端首次启动会写入 data/.env）
.env.local
**/data/.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venv-test/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# 构建产物
*.deb
*.rpm
*.zip
dist/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
